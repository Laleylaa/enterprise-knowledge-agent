", "doc_id": "D01", "title": "差旅报销规定 D01", "version_date": "2026-01-01", "content_hash": "e2224c4c7e19f1ec6fa0fb2d37800a4adfc77c170baed7c44625f5a5e84279b4", "section_id": "D01-S0001", "section_heading": "国内差旅报销规定", "heading_span": {"start": 2, "end": 10}, "chunk_id": "D01-C0001", "source_span": {"start": 0, "end": 12}, "text": "# 国内差旅报销规定\n\n"}], "segments": [], "locators": []}, "errors": [], "execution": {"strategy": "hybrid", "requested_mode": "hybrid", "effective_branches": ["bm25", "vector"], "next_cursor": "wRrPJ6UsCtvzV15bWSyI52rzI5YtXZuu", "has_more": true, "return_limited": false}}
