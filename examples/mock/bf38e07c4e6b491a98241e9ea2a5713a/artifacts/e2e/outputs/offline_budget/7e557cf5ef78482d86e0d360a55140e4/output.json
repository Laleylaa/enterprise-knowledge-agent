      "content_hash": "e2224c4c7e19f1ec6fa0fb2d37800a4adfc77c170baed7c44625f5a5e84279b4",
      "start": 59,
      "end": 122,
      "text": "## 二、提交期限\n\n1. 国内差旅报销须在行程结束后 30 天内提交。\n2. 报销申请的处理状态与上述提交期限分别记录。\n\n",
      "source_spans": [
        {
          "start": 59,
          "end": 122,
          "text": "## 二、提交期限\n\n1. 国内差旅报销须在行程结束后 30 天内提交。\n2. 报销申请的处理状态与上述提交期限分别记录。\n\n"
        }
      ],
      "delivered_to_model": true
    },
    {
      "evidence_id": "7e557cf5ef78482d86e0d360a55140e4:E4",
      "tool_call_id": "offline-1",
