      "start": 12,
      "end": 59,
      "text": "## 一、用途与适用事项\n\n本规定说明员工国内差旅报销的提交期限，以及报销申请的处理状态。\n\n",
      "source_spans": [
        {
          "start": 12,
          "end": 59,
          "text": "## 一、用途与适用事项\n\n本规定说明员工国内差旅报销的提交期限，以及报销申请的处理状态。\n\n"
        }
      ],
      "delivered_to_model": true
    },
    {
      "evidence_id": "7e557cf5ef78482d86e0d360a55140e4:E3",
      "tool_call_id": "offline-1",
      "corpus_hash": "5863212f2b2165ea6237b6a33d04f736d827ec23201925879cb106faf8c533c8",
      "doc_id": "D01",
      "title": "差旅报销规定 D01",
