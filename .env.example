# 从仓库根目录运行时自动加载 .env；系统环境变量覆盖 .env，CLI 参数优先。
# 复制为 .env 后仅在本机填写密钥；不要提交真实密钥。
DEEPSEEK_API_KEY=
KA_MODE=real
KA_MODEL_NAME=deepseek-flash
KA_BASE_URL=https://api.deepseek.com
KA_CORPUS_PATH=data/smoke/manifest.json
# 日常试跑留在本地；提交证据时通过 --output-dir 显式指定 examples 下的分类目录。
KA_OUTPUT_DIR=runtime/runs
KA_MAX_MODEL_TURNS=10
KA_MAX_HTTP_ATTEMPTS=20
KA_MAX_TOOL_CALLS=16
KA_OUTPUT_RETRIES=2
KA_TRANSPORT_RETRIES=1
KA_MODEL_TIMEOUT=30
KA_TOOL_TIMEOUT=10
KA_TURN_TIMEOUT=120
KA_MAX_INPUT_CHARS=100000
KA_MAX_TOOL_CHARS=12000
# 独立检索工具的分块与 BM25 配置；不会切换现有 Agent 冒烟资料源。
KA_TOKENIZER_PATH=runtime/models/bge-small-zh-v1.5-tokenizer/tokenizer.json
KA_RETRIEVAL_CACHE_DIR=runtime/cache/retrieval
KA_CHUNK_TARGET_TOKENS=320
KA_CHUNK_MAX_TOKENS=480
KA_CHUNK_OVERLAP_TOKENS=48
KA_BM25_K1=1.5
KA_BM25_B=0.75
KA_BM25_EPSILON=0.25
KA_SEARCH_CURSOR_CAPACITY=256
KA_READ_CURSOR_CAPACITY=256
# thinking 固定关闭；尚未提供向量／混合检索与会话配置。
