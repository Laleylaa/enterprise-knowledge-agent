# 从仓库根目录运行时自动加载 .env；系统环境变量覆盖 .env，CLI 参数优先。
# 复制为 .env 后仅在本机填写密钥；不要提交真实密钥。
DEEPSEEK_API_KEY=
KA_MODE=real
KA_MODEL_NAME=deepseek-flash
KA_BASE_URL=https://api.deepseek.com
# 日常真实问答资料；Mock按README显式选择对应F1/F2脚本资料。
KA_CORPUS_PATH=data/knowledge_base/manifest.json
KA_PREPARED_PATH=data/prepared/knowledge_base.json
# 日常试跑留在本地；提交证据时通过 --output-dir 显式指定 examples 下的分类目录。
KA_OUTPUT_DIR=runtime/runs
KA_MAX_MODEL_TURNS=10
KA_MAX_HTTP_ATTEMPTS=20
KA_MAX_TOOL_CALLS=16
KA_OUTPUT_RETRIES=2
KA_TRANSPORT_RETRIES=1
KA_MODEL_TIMEOUT=30
KA_TOOL_TIMEOUT=10
KA_TURN_TIMEOUT=120
KA_MAX_INPUT_CHARS=100000
# 保守上下文预算，需不高于实际服务容量；UTF-8 字节估算不是服务端精确 token 数。
KA_MODEL_CONTEXT_TOKENS=65536
KA_MODEL_OUTPUT_TOKENS=2048
KA_MAX_TOOL_CHARS=12000
# 检索工具共享的分块与 BM25 配置；Agent 资料源由 CORPUS_PATH／PREPARED_PATH 选择。
KA_TOKENIZER_PATH=runtime/models/bge-small-zh-v1.5-tokenizer/tokenizer.json
KA_RETRIEVAL_CACHE_DIR=runtime/cache/retrieval
KA_CHUNK_TARGET_TOKENS=320
KA_CHUNK_MAX_TOKENS=480
KA_CHUNK_OVERLAP_TOKENS=48
KA_BM25_K1=1.5
KA_BM25_B=0.75
KA_BM25_EPSILON=0.25
KA_SEARCH_CURSOR_CAPACITY=256
KA_READ_CURSOR_CAPACITY=256
# 真实入口未显式配置时使用 hybrid，可显式选择 bm25／vector。
# Mock 仅支持 bm25；若本地配置了 vector／hybrid，请用 CLI --retrieval bm25 覆盖。
# KA_RETRIEVAL_MODE=hybrid
KA_RRF_K=60
# vector／hybrid 在本地子进程加载 BGE。
KA_EMBEDDING_MODEL_PATH=runtime/models/bge-small-zh-v1.5
KA_EMBEDDING_TIMEOUT=10
KA_EMBEDDING_STARTUP_TIMEOUT=120
KA_EMBEDDING_PREPARE_TIMEOUT=120
KA_EMBEDDING_BATCH_SIZE=16
KA_EMBEDDING_THREADS=2
KA_EMBEDDING_STOP_TIMEOUT=1
# thinking 固定关闭。
# 正式离线脚本建议使用 CLI --mode mock --scenario normal；真实模式不得配置该项。
# KA_MOCK_SCENARIO=normal
